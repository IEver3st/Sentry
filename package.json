{
  "name": "sentry-backup",
  "version": "0.1.0",
  "private": true,
  "description": "Quiet file protection and straightforward recovery for Windows",
  "author": "Means",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests",
    "test": "bun test",
    "engines:fetch": "bun scripts/fetch-engines.ts",
    "package": "bun run build && electron-builder --win nsis --x64",
    "package:dir": "bun run build && electron-builder --win dir --x64",
    "qa": "node --experimental-strip-types scripts/qa.ts",
    "test:service": "bun scripts/test-service.ts",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "picomatch": "^4.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bun": "^1.2.21",
    "@types/node": "^24.3.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "playwright": "^1.55.0",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  },
  "build": {
    "appId": "com.frommeans.sentry",
    "productName": "Sentry",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "engines",
        "filter": [
          "*.exe"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "vendor/notices",
        "to": "notices"
      }
    ],
    "win": {
      "icon": "assets/sentry.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "IEver3st",
        "repo": "Sentry",
        "releaseType": "release"
      }
    ]
  },
  "type": "module"
}
